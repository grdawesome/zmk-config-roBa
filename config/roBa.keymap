#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    scroll-layers = <4>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
            layers = <0>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
            layers = <0>;
        };

        pgup {
            bindings = <&kp PG_UP>;
            key-positions = <12 13>;
        };

        pgdown {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <24 25>;
        };

        home {
            bindings = <&kp HOME>;
            key-positions = <23 24>;
        };

        end {
            bindings = <&kp END>;
            key-positions = <26 25>;
        };

        mb4 {
            bindings = <&mkp MB4>;
            key-positions = <17 18>;
        };

        mb5 {
            bindings = <&mkp MB5>;
            key-positions = <19 20>;
        };

        left {
            bindings = <&kp LEFT>;
            key-positions = <29 30>;
        };

        right {
            bindings = <&kp RIGHT>;
            key-positions = <31 32>;
        };

        up {
            bindings = <&kp UP_ARROW>;
            key-positions = <18 19>;
        };

        down {
            bindings = <&kp DOWN>;
            key-positions = <30 31>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W         &kp E         &kp R                    &kp T                                      &kp Y          &kp U  &kp I      &kp O      &kp P
&kp A      &kp S         &kp D         &kp F                    &kp G      &lt 3 MINUS          &kp COMMA  &kp H          &kp J  &kp K      &kp L      &kp RETURN
&kp Z      &kp X         &kp C         &kp V                    &kp B      &lt 4 SEMICOLON      &kp DOT    &kp N          &kp M  &mkp LCLK  &mkp RCLK  &kp RIGHT_SHIFT
&kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &mt LS(LG(S)) LC(SPACE)  &lt 2 TAB  &lt 1 SPACE          &lt 5 DEL  &kp BACKSPACE                               &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        NUM {
            bindings = <
&kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS   &kp PLUS                                                       &kp LEFT_BRACE  &kp RIGHT_BRACE   &kp EXCLAMATION   &kp AT_SIGN        &kp HASH
&kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp SLASH   &kp ASTERISK  &kp LEFT_PARENTHESIS      &kp RIGHT_PARENTHESIS  &kp LESS_THAN   &kp GREATER_THAN  &kp DOLLAR        &kp PERCENT        &kp CARET
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD  &kp EQUAL     &kp LEFT_BRACKET          &kp RIGHT_BRACKET      &kp SEMICOLON   &kp COLON         &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp AMPERSAND
&kp NUMBER_0  &kp LEFT_GUI  &kp QUESTION  &trans      &trans        &trans                    &kp BACKSLASH          &kp COMMA                                                              &kp UNDERSCORE
            >;
        };

        FUNCTION {
            bindings = <
&trans          &trans        &trans        &trans  &trans                             &kp F1   &kp F2   &kp F3   &kp F4  &kp F5
&trans          &trans        &trans        &trans  &trans  &trans      &kp RS(RG(S))  &kp F6   &kp F7   &kp F8   &kp F9  &kp F10
&kp LEFT_SHIFT  &trans        &trans        &trans  &trans  &trans      &trans         &kp F11  &kp F12  &kp F13  &trans  &kp RIGHT_SHIFT
&kp LCTRL       &kp LEFT_GUI  &kp LEFT_ALT  &trans  &trans  &trans      &trans         &trans                             &kp RCTRL
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &trans        &trans         &trans   &trans                      &trans    &trans          &trans          &trans     &trans
&kp TAB         &trans        &kp PAGE_UP    &trans   &trans  &trans      &trans  &mkp MB5  &mkp LCLK       &kp UP_ARROW    &mkp RCLK  &trans
&kp LEFT_SHIFT  &kp HOME      &kp PAGE_DOWN  &kp END  &trans  &trans      &trans  &mkp MB4  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &kp RIGHT_SHIFT
&kp LCTRL       &kp LEFT_GUI  &kp LEFT_ALT   &trans   &trans  &trans      &trans  &trans                                               &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        SCROLL {
            bindings = <
&trans     &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LCTRL  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings =
                <&inc_dec_kp UP_ARROW DOWN_ARROW>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        BT {
            bindings = <
&trans  &bootloader   &trans        &trans        &trans                                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &bootloader      &bootloader  &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans           &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans           &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
