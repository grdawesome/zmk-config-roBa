#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
            layers = <0>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
            layers = <0>;
        };

        exclamation {
            bindings = <&kp EXCLAMATION>;
            key-positions = <1 2>;
            layers = <0>;
        };

        at {
            bindings = <&kp AT_SIGN>;
            key-positions = <2 3>;
            layers = <0>;
        };

        shrape {
            bindings = <&kp HASH>;
            key-positions = <4 3>;
            layers = <0>;
        };

        dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <15 14>;
            layers = <0>;
        };

        per {
            bindings = <&kp PERCENT>;
            key-positions = <26 27>;
            layers = <0>;
        };

        caret {
            bindings = <&kp CARET>;
            key-positions = <28 29>;
            layers = <0>;
        };

        and {
            bindings = <&kp AMPS>;
            key-positions = <16 17>;
            layers = <0>;
        };

        aster {
            bindings = <&kp ASTERISK>;
            key-positions = <5 6>;
            layers = <0>;
        };

        lpar {
            bindings = <&kp LPAR>;
            key-positions = <6 7>;
            layers = <0>;
        };

        rpar {
            bindings = <&kp RPAR>;
            key-positions = <7 8>;
            layers = <0>;
        };

        lessThan {
            bindings = <&kp COMMA>;
            key-positions = <28 29>;
            layers = <0>;
        };

        gt {
            bindings = <&kp PERIOD>;
            key-positions = <29 30>;
            layers = <0>;
        };

        fl {
            bindings = <&kp FSLH>;
            key-positions = <30 31>;
            layers = <0>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <16 17>;
            layers = <0>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <17 18>;
            layers = <0>;
        };

        lbkt {
            bindings = <&kp LBKT>;
            key-positions = <18 19>;
            layers = <0>;
        };

        rbkt {
            bindings = <&kp RBKT>;
            key-positions = <19 20>;
            layers = <0>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                          &kp T                                                                   &kp Y      &kp U  &lt 5 I    &kp O      &kp P
&kp A             &kp S         &kp D         &kp F                          &kp G                        &kp LS(LG(S))               &kp SQT        &kp H      &kp J  &kp K      &kp L      &kp BACKSPACE
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                          &kp B                        &lt 6 ESC                   &kp BACKSLASH  &kp N      &kp M  &mkp LCLK  &mkp RCLK  &kp ENTER
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt_to_layer_0 3 INT_MUHENKAN  &lt_to_layer_0 2 INT_HENKAN  &lt_to_layer_0 1 SPACE      &kp BACKSPACE  &kp ENTER                               &kp RIGHT_SHIFT
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        NUM {
            bindings = <
&kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS   &kp PLUS                                                       &kp LEFT_BRACE  &kp RIGHT_BRACE   &kp EXCLAMATION   &kp AT_SIGN        &kp HASH
&kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp SLASH   &kp ASTERISK  &kp LEFT_PARENTHESIS      &kp RIGHT_PARENTHESIS  &kp LESS_THAN   &kp GREATER_THAN  &kp DOLLAR        &kp PERCENT        &kp CARET
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD  &kp EQUAL     &kp LEFT_BRACKET          &kp RIGHT_BRACKET      &kp SEMICOLON   &kp COLON         &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp AMPERSAND
&kp NUMBER_0  &kp LEFT_GUI  &trans        &trans      &trans        &trans                    &kp BACKSLASH          &kp COMMA                                                              &kp UNDERSCORE
            >;
        };

        FUNCTION {
            bindings = <
&trans          &trans        &trans        &trans  &trans                             &kp F1   &kp F2   &kp F3   &kp F4  &kp F5
&trans          &trans        &trans        &trans  &trans  &trans      &kp RS(RG(S))  &kp F6   &kp F7   &kp F8   &kp F9  &kp F10
&kp LEFT_SHIFT  &trans        &trans        &trans  &trans  &trans      &trans         &kp F11  &kp F12  &kp F13  &trans  &trans
&kp LCTRL       &kp LEFT_GUI  &kp LEFT_ALT  &trans  &trans  &trans      &trans         &trans                             &trans
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                      &trans    &trans    &kp PAGE_UP    &trans   &trans
&kp TAB         &kp LEFT_ARROW          &trans          &kp RIGHT_ARROW          &trans  &trans      &trans  &mkp MB5  &kp HOME  &trans         &kp END  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &kp DOWN_ARROW  &kp LG(LS(RIGHT_ARROW))  &trans  &trans      &trans  &mkp MB4  &trans    &kp PAGE_DOWN  &trans   &kp RIGHT_SHIFT
&kp LCTRL       &kp LEFT_GUI            &kp LEFT_ALT    &trans                   &trans  &trans      &trans  &trans                                      &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &bootloader   &trans        &trans        &trans                                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &bootloader      &bootloader  &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans           &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans           &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
